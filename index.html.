;font-weight:750;margin:18px 0 8px}.prices{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:30px}.price{font-size:30px;font-weight:800;letter-spacing:-1px}.price small{font-size:13px;color:#9eaecb;font-weight:400}.panel ul{padding-left:18px;color:#b3c0d7;font-size:14px}.panel li{margin:8px 0}.notice{font-size:13px;color:#91a1bf}.cta{background:#101a31;border:1px solid #35466e;border-radius:24px;text-align:center;padding:45px 24px}.cta p{max-width:580px;margin:10px auto 24px}.emailbox{max-width:480px;margin:auto;display:flex;gap:9px}.emailbox input{flex:1;min-width:0;padding:14px;border-radius:12px;border:1px solid #4a5b7c;background:#0b1326;color:white;font:inherit}.emailbox button{white-space:nowrap}footer{padding:32px 0 45px;color:#8190aa;font-size:13px;text-align:center}.error{color:#ffb3b3;font-size:14px;margin-top:12px}#setup{display:none;margin-top:14px;color:#f3c98a;font-size:14px}@media(max-width:800px){.grid{grid-template-columns:1fr}.prices{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.prices{grid-template-columns:1fr}.emailbox{flex-direction:column}.hero{padding:74px 0 55px}h1{letter-spacing:-1.7px}.section{padding:48px 0}}

