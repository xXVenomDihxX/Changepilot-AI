<div class="auth-dialog"><button class="auth-close" id="auth-close" aria-label="Close">×</button><h2 id="auth-heading">Log in</h2><p id="auth-message" class="auth-message" role="status" aria-live="polite"></p>
<form id="auth-form"><input type="email" id="auth-email" placeholder="Email address" autocomplete="email" required><input type="password" id="auth-password" placeholder="Password (12+ characters for sign up)" autocomplete="current-password" required><div class="auth-actions"><button class="btn" id="auth-submit" type="submit">Log in</button></div></form>
<div id="auth-logged-in" hidden><p>Signed in as <strong id="auth-user-email"></strong></p><button class="btn" id="auth-signout" type="button">Log out</button></div>
<div class="auth-actions" id="auth-switches"><button class="auth-link" id="auth-toggle" type="button">Create an account</button><button class="auth-link" id="auth-reset" type="button">Forgot password?</button></div>
</div></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script>
// IMPORTANT: Replace this with an inbox you control before publishing.
const CONTACT_EMAIL = 'REPLACE_WITH_YOUR_EMAIL@example.com';
document.getElementById('year').textContent=new Date().getFullYear();
document.getElementById('interest').addEventListener('submit',function(e){e.preventDefault();const email=document.getElementById('email').value.trim();const status=document.getElementById('status');if(!document.getElementById('email').checkValidity())return;if(CONTACT_EMAIL.includes('REPLACE_WITH_')){status.textContent='Early access signup is not configured yet. Please check back soon.';return;}const subject=encodeURIComponent('ChangePilot AI early access interest');const body=encodeURIComponent('Please add me to the early access interest list.\n\nMy email: '+email+'\n\nI would like to monitor: ');window.location.href='mailto:'+CONTACT_EMAIL+'?subject='+subject+'&body='+body;status.textContent='Your email app should open with a draft. Please send it to complete your request.';});
</script>
<script>
// Paste only your Supabase Project URL and PUBLIC publishable key here.
// Never paste a secret key, service_role key, or database password.
const SUPABASE_URL = 'https://uoixabtuzqscqhezrdhv.supabase.co';
const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_23y7r_zKIjqdgmyL0ROuXw_rXe9K1OQ';
const authReady = SUPABASE_URL.startsWith('https://') && !SUPABASE_PUBLISHABLE_KEY.startsWith('PASTE_') && !!window.supabase;
const authClient = authReady ? window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY) : null;
const overlay=document.getElementById('auth-overlay'), message=document.getElementById('auth-message'), form=document.getElementById('auth-form');
let authMode='login', currentUser=null;
function showMessage(value){message.textContent=value;}
function updateAuthUI(){
 document.getElementById('account-button').textContent=currentUser?'My account':'Log in / Sign up';
 document.getElementById('auth-logged-in').hidden=!currentUser;
 document.getElementById('auth-switches').hidden=!!currentUser;
 form.hidden=!!currentUser;
 if(currentUser)document.getElementById('auth-user-email').textContent=currentUser.email||'';
}
function setAuthMode(mode){authMode=mode;document.getElementById('auth-heading').textContent=mode==='signup'?'Create account':mode==='reset'?'Reset password':mode==='update'?'Choose new password':'Log in';document.getElementById('auth-submit').textContent=mode==='signup'?'Sign up':mode==='reset'?'Send reset email':mode==='update'?'Update password':'Log in';document.getElementById('auth-toggle').textContent=mode==='login'?'Create an account':'Back to log in';document.getElementById('auth-password').hidden=mode==='reset';document.getElementById('auth-password').required=mode!=='reset';document.getElementById('auth-email').hidden=mode==='update';document.getElementById('auth-email').required=mode!=='update';document.getElementById('auth-password').autocomplete=mode==='login'?'current-password':'new-password';showMessage('');updateAuthUI();}
document.getElementById('account-button').onclick=()=>{overlay.classList.add('open');setAuthMode('login');if(!authReady)showMessage('Site owner: configure Supabase Project URL and publishable key in index.html first.');};
document.getElementById('auth-close').onclick=()=>overlay.classList.remove('open');
overlay.addEventListener('click',e=>{if(e.target===overlay)overlay.classList.remove('open')});
document.addEventListener('keydown',e=>{if(e.key==='Escape')overlay.classList.remove('open')});
document.getElementById('auth-toggle').onclick=()=>setAuthMode(authMode==='login'?'signup':'login');
document.getElementById('auth-reset').onclick=()=>setAuthMode('reset');
form.addEventListener('submit',async e=>{
 e.preventDefault();if(!authClient){showMessage('Supabase is not configured yet.');return;}
 const email=document.getElementById('auth-email').value.trim(), password=document.getElementById('auth-password').value;
 if((authMode==='signup'||authMode==='update')&&password.length<12){showMessage('Use a password of at least 12 characters.');return;}
 const btn=document.getElementById('auth-submit');btn.disabled=true;showMessage('Please wait…');
 try{
  let result;
  if(authMode==='signup')result=await authClient.auth.signUp({email,password,options:{emailRedirectTo:location.origin+location.pathname}});
  else if(authMode==='login')result=await authClient.auth.signInWithPassword({email,password});
  else if(authMode==='reset')result=await authClient.auth.resetPasswordForEmail(email,{redirectTo:location.origin+location.pathname});
  else result=await authClient.auth.updateUser({password});
  if(result.error)throw result.error;
  showMessage(authMode==='signup'?(result.data.session?'Account created. You are signed in.':'Check your email for a confirmation link.'):authMode==='reset'?'If this email is registered, a reset link will be sent.':authMode==='update'?'Password updated.':'Logged in successfully.');
  if(authMode==='update')setTimeout(()=>setAuthMode('login'),1500);
 }catch(err){showMessage(err.message||'Something went wrong.');}finally{btn.disabled=false;}
});
document.getElementById('auth-signout').onclick=async()=>{if(!authClient)return;const {error}=await authClient.auth.signOut();showMessage(error?error.message:'Logged out.');};
if(authClient){
 authClient.auth.getUser().then(({data})=>{currentUser=data.user;updateAuthUI();}).catch(()=>{});
 authClient.auth.onAuthStateChange((event,session)=>{currentUser=session?.user||null;updateAuthUI();if(event==='PASSWORD_RECOVERY'){overlay.classList.add('open');setAuthMode('update');}});
}
</script></body></html>
